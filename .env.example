# Biblios local-development environment template.
#
# Copy this file to .env, replace every placeholder, and keep .env untracked.
# The backend deliberately refuses placeholder, known-default, or short secrets.

APP_ENV=development

POSTGRES_DB=biblios
POSTGRES_USER=biblios
POSTGRES_PASSWORD=replace-with-random-database-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-random-redis-password
REDIS_PORT=6379

JWT_SECRET=replace-with-at-least-32-random-characters

PGADMIN_EMAIL=replace-with-local-admin-email
PGADMIN_PASSWORD=replace-with-random-pgadmin-password
PGADMIN_PORT=5050

BACKEND_PORT=8081
FRONTEND_PORT=5173

# Optional. Leave empty when Google Books lookup is not needed.
GOOGLE_BOOKS_API_KEY=
